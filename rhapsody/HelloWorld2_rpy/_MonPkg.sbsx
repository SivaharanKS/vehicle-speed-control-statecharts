			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a"> //if(throttle2&gt;(2.0*brakePedal2))%0D
 if(throttle2&gt;0.0)  %0D
  {%0D
    	throttle2 -= (brakePedal2/2);%0D
  }%0D
 else throttle2 = 0.0;       %0D
  %0D
 return throttle2;</_bodyData>
