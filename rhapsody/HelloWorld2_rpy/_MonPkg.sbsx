			<_final type="a">0</_final>
			<_concurrency type="a">Sequential</_concurrency>
			<_protection type="a">iPublic</_protection>
			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">%0D
fspeed=fspeed-1.5*sin(alpha*3.14/180)+((throttle-fspeed/airResistance))/5;%0D
%0D
if(fspeed&gt;MAX_SPEED) fspeed=MAX_SPEED;%0D
if(fspeed&lt;0) fspeed=0;%0D
%0D
fdist=fdist+(fspeed/36.0)/5.0;%0D
%0D
speed=(int)fspeed;%0D
%0D
distance=(int)fdist;%0D
%0D
if(throttle&gt;0.0) throttle-=(0.5/10.0);  %0D
%0D
%0D
</_bodyData>
			</IBody>
			</_itsBody>
			<AggregatesList type="e">
				<value>GUID 9a566f75-1220-46e7-b045-c6284b094d8e</value>
			</AggregatesList>
