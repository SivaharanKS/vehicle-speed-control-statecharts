			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">%0D
fspeed2=fspeed2-1.5*sin(alpha*3.14/180)+((throttle2-fspeed2/airResistance))/5;%0D
%0D
if(fspeed2&gt;MAX_SPEED) fspeed2=MAX_SPEED;%0D
if(fspeed2&lt;0) fspeed2=0;%0D
%0D
speed2=(int)fspeed2;%0D
%0D
if(throttle2&gt;0.0) throttle2-=(0.5/10.0);  %0D
%0D
%0D
</_bodyData>
