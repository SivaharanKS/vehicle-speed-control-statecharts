										- m_str = "tm(100)/GetData();

if (Button==0) OUT_PORT(toVehicule)->setVolantBouton(0);
if (Button==1) OUT_PORT(toVehicule)->setVolantBouton(1);
if (Button==2) OUT_PORT(toVehicule)->setVolantBouton(2);
if (Button==3) OUT_PORT(toVehicule)->setVolantBouton(3);
if (VolantAngle==0)  OUT_PORT(toVehicule)->setVolantDirection(0);
if (VolantAngle==1)  OUT_PORT(toVehicule)->setVolantDirection(1);

if (VolantAcc-biais_accel>0) OUT_PORT(toVehicule)->setAccelPedalFromVolant((VolantAcc-biais_accel)/10);
else  OUT_PORT(toVehicule)->setAccelPedalFromVolant(0);  

if (VolantFrein-biais_frein>0) OUT_PORT(toVehicule)->setBrakePedalFromVolant((VolantFrein-biais_frein)/10);
else  OUT_PORT(toVehicule)->setBrakePedalFromVolant(0);";
