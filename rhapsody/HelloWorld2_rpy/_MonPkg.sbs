					- _abstract = 0;
					- _final = 0;
					- _concurrency = Sequential;
					- _protection = iPublic;
					- _static = 0;
					- _constant = 0;
					- _itsBody = { IBody 
						- _bodyData = "      //\´\ò\¿\ª\´\®\¿\Ú
	g_hCom = CreateFile(_T(\"COM9\"), GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, NULL);


	//\É\è\Ö\Ã\¶\Á\³\¬\Ê\±
	COMMTIMEOUTS timeouts;
	GetCommTimeouts(g_hCom, &timeouts);
	timeouts.ReadIntervalTimeout = 0;
	timeouts.ReadTotalTimeoutMultiplier = 0;
	timeouts.ReadTotalTimeoutConstant = 1000;
	timeouts.WriteTotalTimeoutMultiplier = 0;
	timeouts.WriteTotalTimeoutConstant = 0;
	SetCommTimeouts(g_hCom, &timeouts);

	//\É\è\Ö\Ã\´\®\¿\Ú\Å\ä\Ö\Ã\Ð\Å\Ï\¢
	DCB dcb;

	int nBaud = 9600;
	dcb.DCBlength = sizeof(DCB);
	dcb.BaudRate = nBaud;//\²\¨\Ì\Ø\Â\Ê\Î\ª6000
	dcb.Parity = 0;//\Ð\£\Ñ\é\·\½\Ê\½\Î\ª\Î\Þ\Ð\£\Ñ\é
	dcb.ByteSize = 8;//\Ê\ý\¾\Ý\Î\»\Î\ª8\Î\»
	dcb.StopBits = ONESTOPBIT;//\Í\£\Ö\¹\Î\»\Î\ª1\Î\»


							  //\É\è\Ö\Ã\¶\Á\Ð\´\»\º\³\å\Ç\ø\´\ó\Ð\¡
	static const int g_nZhenMax = 32768;
    DWORD wCount = 6 ;

	//\Ç\å\¿\Õ\»\º\³\å
	PurgeComm(g_hCom, PURGE_RXCLEAR | PURGE_TXCLEAR);




   /*
    
	while (1) {
		unsigned char buf[6];
		
		memset(buf, 0, 5);
		DWORD nLenOut = 0;
		if (ReadFile(g_hCom, buf, 6, &nLenOut, NULL))
		{
			if (nLenOut) {//\³\É\¹\¦
						  
					printf(\"%x    \", buf[0]); //1er octet?: delimiteur?de debut (caract\¨\¨re?: ) valeur 0x3A hexa 
				//	start = buf[0];
					
					printf(\"%d    \", buf[1]); //2eme octet?: valeur du frein de 0 a 100
			//		VolantFrein = buf[1];
					
					printf(\"%d    \", buf[2]); //3eme octet?: valeur de accelerateur de 0 a 100
			//		VolantAcc = buf[2];	
									
					buf[3]=buf[3]>>7; 					
					printf(\"%d\", buf[3]);    //4eme octet?: angle volant?voir explication apres  
			//		VolantAngle = buf[3]; 					
					printf(\"   \"); 
					
					printf(\"%d    \", buf[4]); //5eme octet?: activation des boutons?
                    Button= (int) buf[4];

					
					printf(\"%0x    \", buf[5]);  //6eme octet?: delimiteur de fin 0x0D
				//	fin = buf[5];
				
			
				printf(\"***********\\n\");

			}

			else//\³\¬\Ê\±
				printf(\"time out\\n\");
		}
		else
			//\Ê\§\°\Ü
			printf(\"fail to read\\n\");

	} 
	
	
*/
	//CloseHandle(g_hCom);   
	";
					}
				}
