					- _id = GUID 4c408d96-5216-4d97-856a-366cdf34ef9f;
					- _myState = 8192;
					- _name = "reguler";
					- _virtual = 0;
					- Args = { IRPYRawContainer 
						- size = 0;
					}
					- _returnType = { IHandle 
						- _m2Class = "IType";
						- _filename = "PredefinedTypesC++.sbs";
