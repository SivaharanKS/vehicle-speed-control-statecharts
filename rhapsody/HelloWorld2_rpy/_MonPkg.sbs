					- _static = 0;
					- _constant = 0;
					- _itsBody = { IBody 
						- _bodyData = "if (speed>vitesseConsigne) {               
	error  = (double) (15*(vitesseConsigne - speed) / 6);
	steady = (double) (vitesseConsigne / 12.0);  
	//double tempo = steady+error;
	setThrottle(steady+error);
	}";
					}
				}
