			- Operations = { IRPYRawContainer 
				- size = 7;
				- value = 
				{ IPrimitiveOperation 
					- _id = GUID 651af6da-7db9-44b9-8b75-e68c00db1940;
					- _myState = 8192;
					- _name = "GetData";
					- _virtual = 0;
					- Args = { IRPYRawContainer 
						- size = 0;
					}
					- _returnType = { IHandle 
						- _m2Class = "IType";
						- _filename = "PredefinedTypesC++.sbs";
						- _subsystem = "PredefinedTypesCpp";
						- _class = "";
						- _name = "void";
						- _id = GUID c6b70728-b655-45a0-abb7-8ea5d3da94be;
					}
					- _abstract = 0;
					- _final = 0;
					- _concurrency = Sequential;
					- _protection = iPublic;
					- _static = 0;
					- _constant = 0;
					- _itsBody = { IBody 
						- _bodyData = "
		unsigned char buf[6];
		
		memset(buf, 0, 5);
		DWORD nLenOut = 0;
		if (ReadFile(g_hCom, buf, 6, &nLenOut, NULL))
		{
			if (nLenOut) {//\³\É\¹\¦
						  
					printf(\"%x    \", buf[0]); //1er octet?: delimiteur?de debut (caract\¨\¨re?: ) valeur 0x3A hexa 
				//	start = buf[0];
					
					printf(\"%d    \", buf[1]); //2eme octet?: valeur du frein de 0 a 100
					VolantFrein = buf[1];
					
					printf(\"%d    \", buf[2]); //3eme octet?: valeur de accelerateur de 0 a 100
					VolantAcc = buf[2];	
									
					buf[3]=buf[3]>>7; 					
					printf(\"%d\", buf[3]);    //4eme octet?: angle volant?voir explication apres  
					VolantAngle = buf[3]; 					
					printf(\"   \"); 
					
					printf(\"%d    \", buf[4]); //5eme octet?: activation des boutons?
                    Button= (int) buf[4];

					
					printf(\"%0x    \", buf[5]);  //6eme octet?: delimiteur de fin 0x0D
				//	fin = buf[5];
				
			
				printf(\"***********\\n\");

			}

			else//\³\¬\Ê\±
				printf(\"time out\\n\");
		}
		else
			//\Ê\§\°\Ü
			printf(\"fail to read\\n\");

	";
					}
				}
